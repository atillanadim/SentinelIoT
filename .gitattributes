* text=auto eol=lf

# Arquivos que precisam de LF mesmo no Windows, pois sao usados em containers Linux.
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
Dockerfile* text eol=lf
*.service text eol=lf

# Scripts PowerShell podem usar CRLF no Windows.
*.ps1 text eol=crlf
