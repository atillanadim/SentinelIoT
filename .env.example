# SentinelIoT - exemplo de variaveis de ambiente.
# Copie para .env e ajuste. NUNCA grave credenciais reais neste arquivo.

SENTINELIOT_CONFIG=config/config.yaml
SENTINELIOT_DATA_DIR=./data
SENTINELIOT_LOG_LEVEL=INFO

# O modo seguro inicial e observe. Nao habilite enforce sem homologacao.
SENTINELIOT_MODE=observe
